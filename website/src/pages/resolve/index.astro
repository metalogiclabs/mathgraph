---
import ResolveExplorer from '../../components/ResolveExplorer.astro';
import SourceLink from '../../components/SourceLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLatestPublishedRecord } from '../../lib/catalog';

const published = await getLatestPublishedRecord('mg-living-warrant-openai-jpl-20261010');
const { entry, record, scenarios } = published;
---

<BaseLayout title="MathGraph Resolve — Evidence consequence resolution" description="Inspect how source-pinned evidence changes propagate locally while unsupported mathematical truth remains UNKNOWN." currentPath="/resolve/">
  <header class="shell resolve-product-hero">
    <div>
      <div class="eyebrow">MathGraph Resolve</div>
      <h1>Evidence can change without truth becoming false.</h1>
      <p class="lede">Resolve recomputes what remains justified under declared evidence, dependencies, scopes, and withdrawals. It preserves alternative support, localizes change, and leaves unsupported conclusions <code>UNKNOWN</code>.</p>
      <div class="actions">
        <a class="button" href={`/records/${entry.id}/`}>Inspect the permanent record</a>
        <a class="button button--secondary" href={new URL(entry.record_json_url).pathname}>Open immutable JSON</a>
      </div>
    </div>
    <aside class="resolve-product-hero__aside">
      <p><strong>Historic snapshot</strong><br /><span class="muted">Seven source-bound claim states</span></p>
      <p><strong>Offline replay</strong><br /><span class="muted">No website, service, LLM, or network</span></p>
      <p><strong>Current applicability</strong><br /><code>{entry.current_applicability}</code></p>
    </aside>
  </header>

  <section class="section section--compact" aria-labelledby="resolve-principles-title">
    <div class="shell">
      <div class="eyebrow">Resolution rules</div>
      <h2 id="resolve-principles-title">Change only what the evidence requires.</h2>
      <div class="resolve-principles">
        <article><span>01</span><h3>Support is reclosed locally.</h3><p>Withdrawing a receipt affects its admitted descendants, not every claim in the catalogue.</p></article>
        <article><span>02</span><h3>Independent support remains.</h3><p>A surviving qualified route can continue to justify a claim at the route's exact scope.</p></article>
        <article><span>03</span><h3>Cycles cannot create evidence.</h3><p>A dependency loop without a valid evidence root remains <code>UNKNOWN</code>.</p></article>
        <article><span>04</span><h3>Stale is not refuted.</h3><p>Loss of documentary support does not establish the negation of a mathematical proposition.</p></article>
      </div>
    </div>
  </section>

  <section class="section resolve-demo-section" aria-labelledby="resolve-demo-title">
    <div class="shell">
      <div class="grid resolve-demo-intro">
        <div class="span-5">
          <div class="eyebrow">Qualified example</div>
          <h2 id="resolve-demo-title">When mathematical evidence changes</h2>
        </div>
        <div class="span-7">
          <p class="lede">Three OpenAI publisher-documented support paths become <code>STALE</code>. The related propositions remain <code>UNKNOWN</code>. An unrelated qualified JPL 48-case observation remains <code>WARRANTED_BOUNDED</code> at its original exact scope. Compare the qualified history with the modeled baseline or one explicit counterfactual below.</p>
          <p>{record.interpretation.simulated_before}</p>
        </div>
      </div>
      <ResolveExplorer published={published} />
      <p><a href="/objects/">Inspect canonical source objects and exact declared relations →</a></p>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="resolve-authority-title">
    <div class="shell grid">
      <div class="span-5">
        <div class="eyebrow">Authority and limits</div>
        <h2 id="resolve-authority-title">The interface is not the trust root.</h2>
        <p class="muted">The immutable bundle can be replayed without MathGraph.org. Pinned hashes detect substitution relative to a separately trusted digest; they do not authenticate a publisher or establish truth by themselves.</p>
      </div>
      <div class="span-7">
        <SourceLink href={scenarios.provenance.producer.run_url} label="Producer qualification" meta={`run ${scenarios.provenance.producer.run_id} · ${scenarios.provenance.producer.commit}`} />
        <SourceLink href={scenarios.provenance.consumer.run_url} label="Same-owner RealityGraph replay" meta={`run ${scenarios.provenance.consumer.run_id} · no original JPL Lean rerun`} />
        <SourceLink href={`https://github.com/metalogiclabs/mathgraph/actions/runs/${entry.independent_replay_ci_run}`} label="Isolated offline replay" meta={`run ${entry.independent_replay_ci_run} · network denied`} />
        <p class="fineprint">The RealityGraph consumer is implementation-independent under the same owner. It is not independent outside-organization adoption and did not rerun the original JPL Lean proof.</p>
      </div>
    </div>
  </section>
</BaseLayout>
