---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeMap from '../../components/KnowledgeMap.astro';
import { loadObjectProjections } from '../../data/object-projections';
import { buildKnowledgeMap } from '../../lib/knowledge-map';
const map = buildKnowledgeMap(await loadObjectProjections());
---
<BaseLayout title="Canonical objects — MathGraph" description="Inspect exact source-qualified object identities, typed declared relations and unknowns in a non-authoritative bounded presentation." currentPath="/objects/">
  <header class="shell section section--compact"><div class="eyebrow">Explore knowledge</div><h1>Every object keeps its source.</h1><p class="lede">Inspect declared connections, exact identities and separate status axes. This display adds no verification authority.</p><p>No declared alternative support route exists in this historical graph. The <a href="/resolve/#resolve-synthetic-conformance">clearly synthetic alternative-support conformance simulation</a> is separate from the published record.</p><p><a href="/records/">Historical records</a> · <a href="/explore/">Explore</a></p></header>
  <div class="shell section"><KnowledgeMap map={map} id="objects-map" /></div>
</BaseLayout>
