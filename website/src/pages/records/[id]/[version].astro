---
import RecordDetail from '../../../components/RecordDetail.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadPublishedRecords, type PublishedRecordPackage } from '../../../lib/catalog';
import { projectPublishedRecord } from '../../../lib/object-projections';
import { objectSlug } from '../../../lib/object-locators';

export async function getStaticPaths() {
  const records = await loadPublishedRecords();
  return records.map((published) => ({
    params: { id: published.entry.id, version: published.entry.version_slug },
    props: { published },
  }));
}

interface Props {
  published: PublishedRecordPackage;
}

const { published } = Astro.props;
const { entry } = published;
const sourceObject = projectPublishedRecord(published).objects[0];
---

<BaseLayout
  title={`${published.record_kind === 'SOURCE_CHECK' ? published.record.title : published.presentation.title} — MathGraph`}
  description={published.record_kind === 'SOURCE_CHECK' ? 'Inspect the exact source pins, finite observations, Lean replay receipts, discrepancies, and unknowns in this permanent version of the qualified L4YAML evidence record.' : published.presentation.description}
  currentPath={`/records/${entry.id}/`}
  canonicalPath={new URL(entry.record_page_url).pathname}
  socialImage={`/social/records/${entry.id}-${entry.version_slug}.png`}
  ogType="article"
>
  <RecordDetail published={published} />
  <p class="shell"><a href={`/objects/${objectSlug(sourceObject.id)}/`}>Inspect this record’s canonical object projection →</a> · <a href="/objects/">All objects and declared relations</a></p>
</BaseLayout>
