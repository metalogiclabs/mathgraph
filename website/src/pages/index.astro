---
import EvidenceBoundary from '../components/EvidenceBoundary.astro';
import Metric from '../components/Metric.astro';
import RecordSummary from '../components/RecordSummary.astro';
import SourceNeighborhood from '../components/SourceNeighborhood.astro';
import StatusTag from '../components/StatusTag.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import capabilityRegistry from '../../public/capabilities/index-v1.json';
import { loadLivingKnowledgeProjections } from '../data/source-catalogue';
import { getLatestPublishedRecord } from '../lib/catalog';
import { buildKnowledgeNeighborhood } from '../lib/knowledge-map';
import { deriveNetworkMetrics } from '../lib/network-metrics';
import { objectSlug } from '../lib/object-locators';
import { loadSourceCatalogueV1 } from '../lib/source-catalogue';
import { capabilityContract } from '../lib/modules';
import {
  importCheckoutReplayCommand,
  importConsumerSourceUrl,
  importImplementationCommit,
  importPolicySourceUrl,
} from '../lib/import-replay';

const { entry, record } = await getLatestPublishedRecord('mg-l4yaml-source-check-20261010');
const [catalogue, objects] = await Promise.all([
  loadSourceCatalogueV1(),
  loadLivingKnowledgeProjections(),
]);
const metrics = deriveNetworkMetrics(catalogue, objects, capabilityRegistry);
const capability = objects.objects.find(object => object.kind === 'FINITE_CAPABILITY')!;
const representative = objects.objects.find(object => object.kind === 'SOURCE_DECLARATION' && object.title === 'Real.rpow');
if (!representative) throw new Error('REPRESENTATIVE_SOURCE_OBJECT_MISSING');
const representativeDetails = representative.details as {
  declaration_kind: string;
  statement: string;
  statement_sha256: string;
  source: { repository: string; commit: string; tree: string; module: string; path: string };
};
const representativeRoute = `/objects/${objectSlug(representative)}/`;
const sourceMap = buildKnowledgeNeighborhood(objects, representative.id, { depth: 1, maxNodes: 6, maxEdges: 10 });
const finite = record.axes.finite_executable;
const format = (value: number) => value.toLocaleString('en-US');
---

<BaseLayout title="MathGraph — Open Verification Infrastructure" description="Explore a pinned Mathlib slice, inspect exactly scoped verification evidence, and identify what remains unknown or stale." currentPath="/">
  <header class="shell home-hero">
    <div class="home-hero__copy">
      <div class="eyebrow">Open verification infrastructure</div>
      <h1>Knowledge you can verify. Capabilities you can build on.</h1>
      <p class="lede">Search real mathematical objects, follow exact source-backed connections, and inspect what independent evidence does—and does not—establish.</p>
      <p>Explore source-pinned mathematics, inspect independently qualified evidence, and discover what remains unresolved. Start with the published Mathlib slice and reproducible verification cases; arbitrary repository or proof submission is not currently hosted.</p>
      <form class="home-search" action="/explore/" method="get" data-home-search>
        <label for="home-search-query">Search the living knowledge network</label>
        <div class="home-search__controls">
          <input id="home-search-query" name="q" type="search" placeholder="Try Real.rpow, topology, or a theorem statement" autocomplete="off" />
          <button class="button" type="submit">Explore</button>
        </div>
        <p class="fineprint">This is a 13-module slice of Mathlib, not all of Mathlib. Search includes source-indexed declarations, separately qualified records, and bounded capabilities; indexing is not independent proof checking.</p>
      </form>
      <div class="actions">
        <a class="button button--secondary" href="/verify/">Inspect real evidence</a>
        <a class="button button--secondary" href="/protocol/">Understand the protocol</a>
      </div>
    </div>
    <aside class="home-hero__signal" aria-label="Status boundaries represented in the network">
      <div class="eyebrow">Three distinct signals</div>
      <ol>
        <li><span>Source occurrence</span><strong>SOURCE_INDEXED</strong><small>Independent verification NOT_CHECKED</small></li>
        <li><span>Check result</span><strong>WARRANTED_BOUNDED</strong><small>Exact finite observation only</small></li>
        <li><span>Reusable capability</span><strong>QUALIFIED_BOUNDED</strong><small>Declared inputs and assumptions</small></li>
      </ol>
      <p class="fineprint">No combined truth score. No action authorization.</p>
    </aside>
  </header>

  <section class="section section--compact network-snapshot" aria-labelledby="network-snapshot-title">
    <div class="shell">
      <div class="network-snapshot__header">
        <div><div class="eyebrow">Published network snapshot</div><h2 id="network-snapshot-title">Substantial source coverage. Deliberately separate evidence.</h2></div>
        <p>Every number below is derived at build time from validated, versioned contracts. They are not added into a single adoption or verification total.</p>
      </div>
      <div class="metric-grid network-metrics">
        <Metric value={format(metrics.indexedObjects)} label="Indexed declarations" detail="Pinned Mathlib source occurrences" />
        <Metric value={format(metrics.qualifiedResults)} label="Qualified bounded result" detail="Unique independently admitted Check result" />
        <Metric value={format(metrics.typedRelations)} label="Typed source-backed relations" detail="Structural and qualified-evidence relations" />
        <Metric value={format(metrics.externalProjects)} label="External source projects" detail="Allowlisted repository identities" />
        <Metric value={format(metrics.qualifiedCapabilities)} label="Qualified reusable capability" detail="Registry entry with bounded replay" />
      </div>
      <div class="network-snapshot__details">
        <p><strong>Source structure:</strong> DECLARES {format(metrics.relationBreakdown.DECLARES ?? 0)} · TYPE_REFERENCES {format(metrics.relationBreakdown.TYPE_REFERENCES ?? 0)} · IMPORTS_MODULE {format(metrics.relationBreakdown.IMPORTS_MODULE ?? 0)}</p>
        <p><strong>Evidence structure:</strong> EVIDENCE_FOR {format(metrics.relationBreakdown.EVIDENCE_FOR ?? 0)} · WITHDRAWS {format(metrics.relationBreakdown.WITHDRAWS ?? 0)}</p>
        <details><summary>Exact external project identities</summary><ul>{metrics.externalProjectIdentities.map(project => <li><a href={project}>{project}</a></li>)}</ul></details>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="journeys-title">
    <div class="shell">
      <div class="eyebrow">Three ways in</div>
      <h2 id="journeys-title">Follow the outcome you need.</h2>
      <ul class="outcome-grid">
        <li data-outcome="explore"><h3><a href="/explore/">Explore knowledge</a></h3><p>Inspect source-pinned records and their declared relations. Keep unknowns in view.</p><p><a href="/discover/">Discover</a> is advisory: it allocates attention, not truth confidence.</p></li>
        <li data-outcome="verify"><h3><a href="/verify/">Verify a claim</a></h3><p>Recognize the supported local record, inspect the historical receipt, and replay the independent consumer.</p><p><a href="/check/">Check</a> preserves source scope. <a href="/resolve/">Resolve</a> replays a bounded historical dependency graph.</p></li>
        <li data-outcome="build"><h3><a href="/build/">Build on a capability</a></h3><p>Inspect one independently replayable finite capability and the precise conditions for reuse.</p><p><a href="/develop/">Develop</a> has a qualified finite profile. The Capability Family Compiler remains unimplemented.</p></li>
      </ul>
      <p class="fineprint">The modules exchange evidence at different maturity levels. There is no autonomous loop or hosted execution service.</p>
    </div>
  </section>

  <section id="source-to-result" class="section" aria-labelledby="source-result-title">
    <div class="shell">
      <div class="eyebrow">Real source → bounded result</div>
      <h2 id="source-result-title">Public JPL Lean source. An independently scoped check.</h2>
      <p class="lede">Using a public Lean 4 repository from NASA JPL as a third-party case study, the L4YAML source check follows an exact revision and decoded YAML-suite cases into published Lean and executable-parser receipts.</p>
      <dl class="definition-list">
        <div><dt>Source</dt><dd><a href={record.evidence.external_sources.jpl}>{record.source.repo}</a> at <code>{record.source.commit}</code></dd></div>
        <div><dt>Suite</dt><dd><a href={record.evidence.external_sources.yaml_suite}>{record.source.external_suite_repo}</a> at <code>{record.source.external_suite_commit}</code></dd></div>
        <div><dt>Finite observation</dt><dd>{finite.matched_external_labels}/{finite.source_cases} decoded cases matched; {finite.expected_accept} accept, {finite.expected_reject} reject. {finite.total_lean_guards}/{finite.total_lean_guards} Lean guards include {finite.extra_controls} additional controls.</dd></div>
        <div><dt>Historical receipt</dt><dd><a href={record.evidence.v2_normalized_native_parser.url}>Inspect the normalized native parser run</a>. Whole-language correctness, statement fidelity, and generalization remain UNKNOWN.</dd></div>
      </dl>
      <p class="qualified-relation"><code>mathgraph.l4yaml.48-case-qualification</code> <strong>EVIDENCE_FOR</strong> <code>jpl.l4yaml.finite_parser_acceptance</code> · source pointer <code>/derivation/routes/3/evidence/0</code></p>
      <p class="fineprint">This typed relation is copied from the qualified record projection. It does not generalize the finite observation or establish a new proof.</p>
      <p class="fineprint">Independent check of public third-party code. No affiliation or endorsement implied. The site displays published receipts; it does not rerun the original JPL Lean proof.</p>
      <RecordSummary record={record} entry={entry} />
    </div>
  </section>

  <section id="map-preview" class="section" aria-labelledby="map-title">
    <div class="shell">
      <div class="grid source-feature">
        <div class="span-5">
          <div class="eyebrow">A real mathematical object</div>
          <h2 id="map-title">Open a declaration. Follow what its source actually says.</h2>
          <p class="lede"><code>Real.rpow</code> is one exact declaration occurrence in the pinned Mathlib catalogue—not a MathGraph-verified theorem.</p>
          <dl class="definition-list source-feature__identity">
            <div><dt>Declaration</dt><dd><a href={representativeRoute}>Real.rpow</a> · {representativeDetails.declaration_kind}</dd></div>
            <div><dt>Module</dt><dd><code>{representativeDetails.source.module}</code></dd></div>
            <div><dt>Source pin</dt><dd><code>{representativeDetails.source.commit}</code></dd></div>
            <div><dt>Source status</dt><dd><code>SOURCE_INDEXED</code></dd></div>
            <div><dt>Independent verification</dt><dd><code>NOT_CHECKED</code></dd></div>
          </dl>
          <p><a href={representativeRoute}>Inspect exact source, statement, omissions, and replay →</a></p>
        </div>
        <div class="span-7 source-feature__statement">
          <div class="eyebrow">Rendered declaration type</div>
          <pre tabindex="0"><code>{representativeDetails.statement}</code></pre>
          <p class="fineprint">Statement digest <code>{representativeDetails.statement_sha256}</code>. The hash protects bytes; it does not establish truth or semantic equivalence.</p>
        </div>
      </div>
      <SourceNeighborhood map={sourceMap} id="home-source-network" />
      <p><a href="/explore/?q=Real.rpow">Explore this declaration in the catalogue →</a> · <a href="/objects/">Inspect canonical objects and declared relations</a></p>
      <p class="fineprint">Source relations such as <code>DECLARES</code> and <code>TYPE_REFERENCES</code> support navigation; they are not dependency proofs. Unlike documentation or theorem-search tools, MathGraph also links separately qualified records to exact evidence, scope, and historical changes.</p>
    </div>
  </section>

  <section id="capability" class="section" aria-labelledby="capability-title">
    <div class="shell grid">
      <div class="span-5"><div class="eyebrow">Bounded capability</div><h2 id="capability-title">Reuse starts with explicit conditions.</h2><StatusTag label={capability.axes.historical_result} tone="bounded" /></div>
      <div class="span-7">
        <p class="lede">One finite representation-refinement profile has independent bounded replay.</p>
        <p>{capabilityContract.claim.scope}</p>
        <p>Assumptions stay attached:</p><ul>{capability.assumptions.map(assumption => <li>{assumption}</li>)}</ul>
        <p>Current applicability: <code>{capability.axes.current_applicability}</code>. Freshness: <code>{capability.axes.freshness}</code>. Action authorization: <code>{capability.axes.action_authorization}</code>.</p>
        <p>Same-owner implementation-independent qualification does not establish external adoption. The Capability Family Compiler remains unimplemented; no universal invention theorem is claimed.</p>
        <p><a href="/capabilities/">Inspect the capability registry →</a> · <a href="/develop/">Read the finite replay boundary</a></p>
      </div>
    </div>
  </section>

  <EvidenceBoundary record={record} entry={entry} />

  <section id="independent-verification" class="section" aria-labelledby="independent-title">
    <div class="shell grid">
      <div class="span-5"><div class="eyebrow">Independent verification</div><h2 id="independent-title">Inspect the checker. Choose the trust policy.</h2></div>
      <div class="span-7"><p class="lede">A result is useful when you can trace its source, scope, assumptions, and verifier.</p><p>The local Python importer validates the supported record and replays its historical receipt under a separate pinned policy. The browser only recognizes exact bytes and presents existing evidence. Neither step reruns the original proof or establishes current applicability.</p><p>Obtain consumer and policy pins through a separately trusted channel. Same-origin hashes protect byte integrity; they do not authenticate a publisher.</p><p><a href="/developers/#offline-replay">Independent dependency replay instructions</a> · <a href="/agents/">Agent consumption contract</a> · <a href="/protocol/">Read the protocol</a></p></div>
    </div>
  </section>

  <section id="quick-start" class="section" aria-labelledby="quick-start-title">
    <div class="shell">
      <div class="eyebrow">Executable quick start</div><h2 id="quick-start-title">Import the supported record locally.</h2>
      <p>Clone the repository and detach at exact implementation commit <code>{importImplementationCommit}</code>. With Python available and the separately pinned policy and consumer reviewed:</p>
      <pre tabindex="0" data-home-quick-start><code>{importCheckoutReplayCommand}</code></pre>
      <p>The result uses <code>mathgraph.import-result.v1</code>. Historical bounded receipt validation leaves proof, kernel, and source-suite replay <code>NOT_PERFORMED</code>; freshness <code>NOT_CHECKED</code>; and current applicability <code>UNKNOWN</code>. It authorizes no action.</p>
      <p><a href={importConsumerSourceUrl}>Inspect the pinned independent consumer</a> · <a href={importPolicySourceUrl}>Inspect the separately reviewed policy</a> · <a href="/developers/">Developer setup and consumers →</a></p>
    </div>
  </section>

  <section id="long-term" class="section section--ink" aria-labelledby="long-term-title">
    <div class="shell grid">
      <div class="span-5"><div class="eyebrow">Long-term direction</div><h2 id="long-term-title">Portable evidence across systems.</h2></div>
      <div class="span-7"><p class="lede">MathGraph aims to connect mathematics, scientific workflows, software verification, and machine-generated claims through reusable evidence.</p><p>Today’s foundation is finite and explicit: a source-indexed mathematical catalogue, source-pinned records, a historical dependency replay, one qualified finite capability, and a local record workflow. Broader source adapters, capability compilation, continuous requalification, and hosted resolver or MCP services remain future work. These examples do not establish universal support.</p></div>
    </div>
  </section>
</BaseLayout>
