---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Evidence not found — MathGraph" description="The requested MathGraph evidence route does not exist." currentPath="">
  <section class="section">
    <div class="shell not-found">
      <div class="eyebrow">404 / Unknown route</div>
      <h1>Evidence not found.</h1>
      <p class="lede">No record or documentation page exists at this address. MathGraph does not synthesize missing evidence.</p>
      <div class="button-row"><a class="button button--primary" href="/records/">Browse records</a><a class="button button--secondary" href="/developers/">Read the contract</a></div>
    </div>
  </section>
</BaseLayout>
