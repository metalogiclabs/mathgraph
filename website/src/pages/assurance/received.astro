---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Submission received — MathGraph" description="Your MathGraph Open Challenge submission has been securely received." currentPath="/assurance/received/" noindex>
  <header class="section section--compact"><div class="shell">
    <div class="eyebrow">MathGraph Open Challenge</div>
    <h1>Your submission has been received.</h1>
    <p class="lede">Thank you for explaining what your system needs to get right and which engineering decision depends on it.</p>
    <p>Your enquiry was stored. This does not mean your project has been selected or that a defect will be found. If we select it for a bounded independent investigation, we'll contact you using the email supplied.</p>
    <p>Please do not send credentials, undisclosed security issues or proprietary source through public channels. No automatic code scan or whole-codebase certification is implied.</p>
    <div class="actions"><a class="button" href="/assurance/">Return to the Open Challenge</a><a class="button button--secondary" href="/assurance/privacy/">How we handle your information</a></div>
  </div></header>
</BaseLayout>
