---
import CatalogueFilter from './CatalogueFilter.astro';
import type { ExploreEntry } from '../lib/catalogue-search';

interface Props { entries: ExploreEntry[] }
const { entries } = Astro.props;
const sorted = (values: string[]) => [...new Set(values)].sort((left, right) => left < right ? -1 : left > right ? 1 : 0);
const orderedEntries = [...entries].sort((left, right) => left.title < right.title ? -1 : left.title > right.title ? 1 : left.id < right.id ? -1 : left.id > right.id ? 1 : 0);
const filters = [
  { field: 'project', label: 'Source project', options: sorted(entries.map(entry => entry.project)) },
  { field: 'kind', label: 'Object kind', options: sorted(entries.map(entry => entry.kind)) },
  { field: 'module', label: 'Module / collection', options: sorted(entries.map(entry => entry.module)) },
  { field: 'status', label: 'Exact displayed status', options: sorted(entries.map(entry => entry.status)) },
];
const categoryLabel = {
  SOURCE_INDEXED: 'Source indexed · proof checking not performed',
  EVIDENCE_RECORD: 'Evidence object · inspect its exact boundary',
  QUALIFIED_CAPABILITY: 'Qualified bounded capability',
} as const;
---
<div data-knowledge-catalogue>
  <CatalogueFilter
    id="knowledge"
    total={entries.length}
    filters={filters}
    eyebrow="Living knowledge catalogue"
    heading="Search exact mathematical objects and evidence"
    fineprint="Deterministic name and metadata ranking · no semantic inference"
    queryLabel="Search names, statements and exact identities"
    queryPlaceholder="Try Real.rpow, List.length, or a theorem statement"
    noMatch="No catalogue entry matches this exact local search. Try fewer terms, clear a filter, or inspect the supported import paths under Verify."
    noScript="Every entry remains available without JavaScript. Ranking and local filters are unavailable."
    urlState={true}
    ranked={true}
    searchIndex="/catalogues/mathlib/v4.34.1/search.json"
    searchIndexCount={2345}
  >
    <ol class="knowledge-catalogue__list" data-catalogue-order-root>
      {orderedEntries.map(entry => (
        <li
          data-catalogue-item
          data-catalogue-source={entry.kind === 'SOURCE_DECLARATION' ? true : undefined}
          data-catalogue-source-id={entry.kind === 'SOURCE_DECLARATION' ? undefined : entry.sourceId}
          data-catalogue-search={entry.category === 'SOURCE_INDEXED' ? undefined : `${entry.title} ${entry.sourceId} ${entry.kind} ${entry.module} ${entry.project}`}
          data-catalogue-project={entry.kind === 'SOURCE_DECLARATION' ? undefined : entry.project}
          data-catalogue-kind={entry.kind === 'SOURCE_DECLARATION' ? undefined : entry.kind}
          data-catalogue-module={entry.kind === 'SOURCE_DECLARATION' ? undefined : entry.module}
          data-catalogue-status={entry.kind === 'SOURCE_DECLARATION' ? undefined : entry.status}
        >
          {entry.kind !== 'SOURCE_DECLARATION' && <span class="knowledge-catalogue__category">{categoryLabel[entry.category]}</span>}
          <h3><a data-catalogue-entry-title href={entry.href}>{entry.title}</a></h3>
          <p class="knowledge-catalogue__meta">
            <span>{entry.module}</span>{entry.kind !== 'SOURCE_DECLARATION' && <code>{entry.kind}</code>}<code>{entry.status}</code>
            {entry.independentVerification && <code>{entry.independentVerification}</code>}
          </p>
        </li>
      ))}
    </ol>
  </CatalogueFilter>
</div>
