---
import type { ObjectProjection, RelationProjection } from '../lib/object-projections';
import { objectSlug, sourceHref } from '../lib/object-locators';
import ObjectRelations from './ObjectRelations.astro';
interface Props { object: ObjectProjection; edges: RelationProjection[]; prefix?: string }
const { object, edges, prefix = 'object' } = Astro.props;
const sourceLink = sourceHref(object.source.locator);
const render = (value: unknown) => value === undefined || value === null || value === '' ? 'UNKNOWN' : typeof value === 'string' ? value : JSON.stringify(value, null, 2);
const fields = [
  ['Attribution', object.details.attribution],
  ['Evidence', object.details.evidence ?? object.details.admission],
  ['Scope', object.details.scope ?? (object.details.claim as { scope?: unknown } | undefined)?.scope],
] as const;
---
<article class="object-detail" id={`${prefix}-${objectSlug(object.id)}`} data-object-detail={object.id} tabindex="-1" aria-labelledby={`${prefix}-${objectSlug(object.id)}-title`}>
  <div class="eyebrow">{object.kind}</div>
  <h3 id={`${prefix}-${objectSlug(object.id)}-title`}>{object.title}</h3>
  <p class="fineprint">Presentation projection · authority NONE · not a certificate, proof, or verifier</p>
  <dl class="definition-list">
    <div><dt>Canonical identity</dt><dd><code>{object.id}</code></dd></div>
    <div><dt>Type</dt><dd><code>{object.kind}</code></dd></div>
    <div><dt>Source identity</dt><dd><code>{object.source_id}</code></dd></div>
    <div><dt>Source pointer</dt><dd><a href={sourceLink}><code>{object.pointer || '"" (document root)'}</code></a></dd></div>
  </dl>
  <h4>Six independent status axes</h4>
  <dl class="object-axes">{Object.entries(object.axes).map(([key, value]) => <div><dt><a href={sourceLink}>{key}</a></dt><dd><code>{value || 'UNKNOWN'}</code></dd></div>)}</dl>
  <h4>Source pins</h4>
  <ul class="object-pins">{[object.source, ...object.supporting_sources].map(pin => <li><a href={sourceHref(pin.locator)}>{pin.id}</a> · version {pin.version}<details><summary>Contract, locator and digests</summary><pre><code>{JSON.stringify(pin, null, 2)}</code></pre></details></li>)}</ul>
  <dl class="definition-list">
    {fields.map(([label, value]) => <div><dt>{label}</dt><dd><pre><code>{render(value)}</code></pre></dd></div>)}
    {([
      ['Verifier authority', object.verifier_authority], ['Assumptions', object.assumptions], ['Replay boundary', object.replay_boundary],
      ['Unknowns', object.unknowns], ['Unsupported semantics', object.unsupported_semantics],
    ] as const).map(([label, values]) => <div><dt>{label}</dt><dd>{values.length ? <ul>{values.map(value => <li>{value}</li>)}</ul> : 'UNKNOWN'}</dd></div>)}
  </dl>
  <p class="fineprint">Every value above is a display of the <a href={sourceLink}>source object</a> and the listed supporting pins. Missing fields are UNKNOWN. The complete projected fields remain available below.</p>
  <h4>Incoming relations</h4>
  <ObjectRelations edges={edges.filter(edge => edge.to === object.id)} direction="incoming" prefix={prefix === 'object' ? undefined : prefix} />
  <h4>Outgoing relations</h4>
  <ObjectRelations edges={edges.filter(edge => edge.from === object.id)} direction="outgoing" prefix={prefix === 'object' ? undefined : prefix} />
  <h4>Lineage</h4>
  <p>Source <a href={sourceLink}>{object.source.id}</a> · version <code>{object.source.version}</code> · pointer <code>{object.pointer || '"" (document root)'}</code>. This locator declares no chronology, supersession or equivalence.</p>
  <details><summary>All projected source fields</summary><pre><code>{JSON.stringify(object.details, null, 2)}</code></pre></details>
  <p><a href={`/objects/${objectSlug(object.id)}/`}>Permanent object view</a> · <a href={sourceLink}>Source / export JSON</a> · <a href="/developers/#offline-replay">Reproduction instructions and boundaries</a></p>
  <p class="fineprint">The route slug is a presentation locator only. Use the full canonical identity above.</p>
</article>
