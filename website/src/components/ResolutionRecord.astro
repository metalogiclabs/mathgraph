---
import type { ResolutionSnapshotPackage } from '../lib/catalog';
interface Props { published: ResolutionSnapshotPackage }
const { published } = Astro.props;
const { entry, presentation } = published;
---
<article class="record-card record-card--resolve">
  <div>
    <div class="eyebrow">Resolution snapshot</div>
    <h3><a href={new URL(entry.latest_page_url).pathname}>{presentation.title}</a></h3>
    <p class="muted">Three documentary support paths become stale, three propositions remain unknown, and one unrelated bounded observation keeps its exact warrant.</p>
    <p><a href={new URL(entry.latest_page_url).pathname}>Inspect what remains justified →</a></p>
  </div>
  <div class="record-card__meta">
    <span class="resolve-status" data-status="scoped-mixed">SCOPED_MIXED</span>
    <span class="record-id">{entry.id}</span>
    <span class="fineprint">Version {entry.version} · Catalogue lifecycle {entry.lifecycle.toLowerCase()}</span>
    <span><strong>3</strong> stale support paths · <strong>3</strong> unknown propositions · <strong>1</strong> bounded observation</span>
    <span class="fineprint">Snapshot {entry.snapshot_date} · freshness {entry.freshness.toLowerCase()}</span>
  </div>
</article>
