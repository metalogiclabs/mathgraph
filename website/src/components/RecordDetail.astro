---
import type { PublishedRecordPackage } from '../lib/catalog';
import SourceCheckDetail from './SourceCheckDetail.astro';
import ResolutionRecord from './ResolutionRecord.astro';
interface Props { published: PublishedRecordPackage }
const { published } = Astro.props;
---
{published.record_kind === 'SOURCE_CHECK'
  ? <SourceCheckDetail published={published} />
  : <ResolutionRecord published={published} />}
