---
import type { ObjectProjection, RelationProjection } from '../lib/object-projections';
import { objectSlug } from '../lib/object-locators';
interface Props { edges: RelationProjection[]; direction: 'incoming' | 'outgoing' | 'source'; prefix?: string; objects?: ObjectProjection[] }
const { edges, direction, prefix, objects = [] } = Astro.props;
const byId = new Map(objects.map(object => [object.id, object]));
const target = (id: string) => prefix
  ? `#${prefix}-${objectSlug(id)}`
  : `/objects/${objectSlug(byId.get(id) ?? id)}/`;
---
<div data-relation-group>
  <p data-empty-relations hidden={edges.length > 0}>No declared {direction} relations in this displayed projection.</p>
  <ol class="object-relations" aria-label={`Declared ${direction} relations`} hidden={edges.length === 0}>
    {edges.map(edge => <li data-relation-id={edge.id} data-map-edge={direction === 'source' ? edge.id : undefined}>
      <p><a href={target(edge.from)}><code>{edge.source_id}</code></a> → <strong>{edge.type}</strong> → <a href={target(edge.to)}><code>{edge.target_id}</code></a></p>
      <details><summary>Exact relation and provenance</summary>
        <dl class="definition-list">
          <div><dt>Relation ID</dt><dd><code>{edge.id}</code></dd></div>
          <div><dt>From</dt><dd><code>{edge.from}</code></dd></div>
          <div><dt>To</dt><dd><code>{edge.to}</code></dd></div>
          <div><dt>Direction / authority</dt><dd>directed: true · authority {edge.authority}</dd></div>
          <div><dt>Source pointer</dt><dd><a href={edge.provenance.source.locator}>{edge.provenance.pointer}</a></dd></div>
          <div><dt>Source pin</dt><dd><pre><code>{JSON.stringify(edge.provenance.source, null, 2)}</code></pre></dd></div>
        </dl>
      </details>
    </li>)}
  </ol>
</div>
