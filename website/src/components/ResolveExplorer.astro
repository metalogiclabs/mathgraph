---
import type { ResolutionSnapshotPackage } from '../lib/catalog';

interface Props {
  published: ResolutionSnapshotPackage;
}

const { published } = Astro.props;
const { entry, record, scenarios } = published;
const publishedAfter = scenarios.PUBLISHED_RECORD.scenarios.find((scenario) => scenario.id === scenarios.PUBLISHED_RECORD.default_scenario);
if (!publishedAfter) throw new Error('RESOLVE_DEFAULT_SCENARIO_MISSING');
const modeledBefore = scenarios.PUBLISHED_RECORD.scenarios.find((scenario) => scenario.id === 'modeled-before');
const counterfactual = scenarios.PUBLISHED_RECORD.scenarios.find((scenario) => scenario.id === 'withdraw-openai.original_publication_receipt.1');
if (!modeledBefore || !counterfactual) throw new Error('RESOLVE_FEATURED_SCENARIO_MISSING');

const modeledViews = scenarios.PUBLISHED_RECORD.scenarios.filter((scenario) => scenario.id !== publishedAfter.id);
const claimById = new Map(record.derivation.claims.map((claim) => [claim.id, claim]));
const routeConclusions = new Set(scenarios.PUBLISHED_RECORD.graph.routes.map((route) => route.conclusion));
const resultEntries = Object.entries(publishedAfter.resolutions);
const scenarioName = `resolve-scenario-${entry.id}`;
const scenariosPath = new URL(entry.scenarios_json_url).pathname;
const statusToken = (value: string) => value.toLowerCase().replaceAll('_', '-');
const featuredClaims = {
  support: 'openai.original_support.1',
  proposition: 'openai.theorem.1',
  preserved: 'jpl.l4yaml.finite_parser_acceptance',
} as const;
const comparisonItems = [
  {
    id: featuredClaims.support,
    eyebrow: 'Changed · documentary support',
    title: 'The source-backed support path becomes stale.',
    note: 'This is a support-resolution transition. It does not establish that the mathematical proposition is false.',
  },
  {
    id: featuredClaims.proposition,
    eyebrow: 'Still unresolved · mathematical proposition',
    title: 'The proposition remains UNKNOWN.',
    note: 'It is not REFUTED. No qualified documentary-to-theorem proof or refutation relation is admitted.',
  },
  {
    id: featuredClaims.preserved,
    eyebrow: 'Unaffected · independently bounded observation',
    title: 'The unrelated JPL observation keeps its exact warrant.',
    note: claimById.get(featuredClaims.preserved)?.scope ?? '',
  },
] as const;
for (const item of comparisonItems) {
  if (!publishedAfter.resolutions[item.id as keyof typeof publishedAfter.resolutions]) throw new Error('RESOLVE_FEATURED_CLAIM_MISSING');
}
const documentName = (claimId: string) => {
  const match = claimId.match(/^openai\.(?:original_support|theorem)\.(\d)$/);
  return match ? record.publisher_notice.documents[Number(match[1]) - 1]?.name : undefined;
};
---

<section
  class="resolve-explorer"
  aria-labelledby="resolve-explorer-title"
  data-resolve-explorer
  data-record-id={entry.id}
  data-snapshot-sha256={record.snapshot_sha256}
  data-record-transport-sha256={entry.record_transport_sha256}
  data-scenarios-sha256={entry.scenarios_transport_sha256}
  data-scenarios-url={scenariosPath}
  data-default-classification="PUBLISHED_RECORD"
  data-default-scenario={publishedAfter.id}
>
  <header class="resolve-explorer__header">
    <div>
      <div class="eyebrow">Read-only evidence explorer</div>
      <h2 id="resolve-explorer-title">Inspect a resolution without rerunning it.</h2>
    </div>
    <p class="lede">The historical default below is server-rendered from the qualified snapshot. Optional controls select only precomputed entries from the exact published scenarios artifact; this browser does not resolve claims.</p>
  </header>

  <section class="resolve-comparison" data-resolve-comparison data-selected-scenario={publishedAfter.id} aria-labelledby="resolve-comparison-title">
    <header class="resolve-comparison__header">
      <div>
        <div class="eyebrow">Selective consequence</div>
        <h3 id="resolve-comparison-title">What changed — and what did not</h3>
      </div>
      <p class="fineprint">Three exact objects. No inferred edge between them.</p>
    </header>
    <div class="resolve-comparison__choices" role="group" aria-label="Featured precomputed Resolve views">
      <button type="button" data-resolve-select={publishedAfter.id} data-scenario-classification="PUBLISHED_RECORD" aria-pressed="true" disabled>
        <span>Qualified history</span><small>Published withdrawal state</small>
      </button>
      <button type="button" data-resolve-select={modeledBefore.id} data-scenario-classification="PUBLISHED_RECORD" aria-pressed="false" disabled>
        <span>Modeled baseline</span><small>Not proof of correctness</small>
      </button>
      <button type="button" data-resolve-select={counterfactual.id} data-scenario-classification="PUBLISHED_RECORD" aria-pressed="false" disabled>
        <span>Counterfactual</span><small>Simulate one withdrawn receipt</small>
      </button>
    </div>
    <div class="resolve-comparison__selection">
      <div>
        <code data-resolve-comparison-basis>{publishedAfter.basis}</code>
        <strong data-resolve-comparison-label>{publishedAfter.label}</strong>
      </div>
      <p data-resolve-comparison-description>{publishedAfter.description}</p>
    </div>
    <div data-resolve-comparison-output>
      <div class="resolve-comparison__outcomes">
        {comparisonItems.map((item) => {
          const resolution = publishedAfter.resolutions[item.id as keyof typeof publishedAfter.resolutions];
          return (
            <article data-resolve-outcome={item.id}>
              <div class="eyebrow">{item.eyebrow}</div>
              <h4>{item.title}</h4>
              <code>{item.id}</code>
              <div class="resolve-comparison__transition" aria-label={`Before ${resolution.before}; after ${resolution.after}`}>
                <span><small>Before</small><span data-resolve-before><span class="resolve-status" data-status={statusToken(resolution.before)}>{resolution.before}</span></span></span>
                <b aria-hidden="true">→</b>
                <span><small>After</small><span data-resolve-after><span class="resolve-status" data-status={statusToken(resolution.after)}>{resolution.after}</span></span></span>
              </div>
              <p>{item.note}</p>
            </article>
          );
        })}
      </div>
      <p class="resolve-comparison__withdrawn fineprint" data-resolve-comparison-withdrawn>
        Published withdrawal receipts: {publishedAfter.withdrawn_evidence.map((id) => <code>{id}</code>)}
      </p>
      <p class="resolve-comparison__unchanged" data-resolve-comparison-unchanged><strong>What did not change:</strong> the proposition was not promoted to truth or refutation, and the unrelated bounded JPL route retained its original exact scope.</p>
    </div>
    <p class="callout callout--unknown" data-resolve-comparison-unavailable hidden>This synthetic conformance scenario does not use the OpenAI/JPL comparison objects. Inspect its exact precomputed results below.</p>
    <p class="fineprint"><strong>Precomputed selection only.</strong> This is a simulation/counterfactual interface; the browser neither resolves, qualifies, nor mutates historical evidence.</p>
  </section>

  <div class="resolve-controls" aria-describedby="resolve-controls-boundary">
    <p id="resolve-controls-boundary" class="fineprint"><strong>Display-only.</strong> Controls unlock only after the same-origin artifact passes its pinned byte digest and identity checks. Every hypothetical view is a simulation and never mutates the immutable historic snapshot.</p>
    <fieldset class="resolve-controls__group" data-scenario-group="PUBLISHED_RECORD">
      <legend>Published record views</legend>
      <div class="resolve-control-section">
        <p class="resolve-control-section__label">Qualified historic snapshot</p>
        <label class="resolve-option">
          <input type="radio" name={scenarioName} value={publishedAfter.id} checked disabled data-scenario-classification="PUBLISHED_RECORD" aria-controls="resolve-scenario-result" />
          <span><strong>{publishedAfter.label}</strong><small>{publishedAfter.basis} · the no-JavaScript default</small></span>
        </label>
      </div>
      <div class="resolve-control-section resolve-control-section--modeled">
        <p class="resolve-control-section__label">Modeled and hypothetical views</p>
        <p class="fineprint">The modeled baseline is not proof of correctness. Withdrawal controls show precomputed consequences over that model, not additional historical events.</p>
        {modeledViews.map((scenario) => (
          <label class="resolve-option">
            <input type="radio" name={scenarioName} value={scenario.id} disabled data-scenario-classification="PUBLISHED_RECORD" aria-controls="resolve-scenario-result" />
            <span><strong>{scenario.label}</strong><small>{scenario.basis}</small></span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset id="resolve-synthetic-conformance" class="resolve-controls__group resolve-controls__group--synthetic" data-scenario-group="SYNTHETIC_CONFORMANCE">
      <legend>Synthetic conformance simulations</legend>
      <p>{scenarios.SYNTHETIC_CONFORMANCE.description}</p>
      <p class="fineprint">These small kernel tests are structurally separate from the OpenAI/JPL historical graph and establish no new fact about it.</p>
      {scenarios.SYNTHETIC_CONFORMANCE.scenarios.map((scenario) => (
        <label class="resolve-option">
          <input type="radio" name={scenarioName} value={scenario.id} disabled data-scenario-classification="SYNTHETIC_CONFORMANCE" aria-controls="resolve-scenario-result" />
          <span><strong>{scenario.label}</strong><small>{scenario.basis}</small></span>
        </label>
      ))}
    </fieldset>
  </div>

  <p class="resolve-live fineprint" data-resolve-live aria-live="polite">Static qualified default: {publishedAfter.label}.</p>
  <p class="resolve-error callout callout--unknown" role="alert" data-resolve-error hidden>Interactive scenarios are unavailable. The qualified static default remains shown.</p>
  <p class="fineprint">If an interaction failure occurs after activation, the qualified default is restored directly from its trusted server-rendered clone; the browser renderer is not used as a fallback.</p>
  <noscript><p class="callout callout--unknown">JavaScript is off. The qualified static default remains shown; scenario controls stay disabled.</p></noscript>

  <section id="resolve-scenario-result" class="resolve-view" data-static-qualified-default data-resolve-view aria-labelledby="resolve-scenario-heading">
    <header class="resolve-view__header">
      <div>
        <div class="eyebrow" data-resolve-classification>Qualified historic snapshot</div>
        <h3 id="resolve-scenario-heading" data-resolve-heading>{publishedAfter.label}</h3>
      </div>
      <code data-resolve-basis>{publishedAfter.basis}</code>
    </header>
    <p class="resolve-view__description" data-resolve-description>{publishedAfter.description}</p>

    <div class="table-wrap resolve-results" tabindex="0" role="region" aria-label="Scrollable Resolve result table">
      <table>
        <caption>Before and after support resolution for the selected precomputed scenario</caption>
        <thead>
          <tr><th scope="col">Claim at exact scope</th><th scope="col">Before support</th><th scope="col">After support</th><th scope="col">Selected scenario state</th></tr>
        </thead>
        <tbody data-resolve-results>
          {resultEntries.map(([claimId, resolution]) => (
            <tr data-historical-result-row data-resolve-result-row data-claim-id={claimId}>
              <th scope="row"><code>{claimId}</code>{documentName(claimId) && <small>{documentName(claimId)}</small>}</th>
              <td><span class="resolve-status" data-status={statusToken(resolution.before)}>{resolution.before}</span></td>
              <td><span class="resolve-status" data-status={statusToken(resolution.after)}>{resolution.after}</span></td>
              <td><span class="resolve-status" data-status={statusToken(publishedAfter.states[claimId as keyof typeof publishedAfter.states])}>{publishedAfter.states[claimId as keyof typeof publishedAfter.states]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fineprint">Support transitions come from <code>resolutions</code>. Raw selected-scenario claim states come from <code>states</code>. <code>STALE</code> means support was withdrawn; it is not a refutation.</p>

    <div class="resolve-graph" role="group" aria-label="Typed dependency view">
      <section>
        <h4>Declared evidence receipts</h4>
        <ul data-resolve-receipts>
          {scenarios.PUBLISHED_RECORD.graph.receipts.map((receipt) => (
            <li><code>{receipt.id}</code><small>{receipt.kind} · {receipt.scope}</small></li>
          ))}
        </ul>
        <div class="resolve-exact-field">
          <h5>Exact <code>withdrawn_evidence</code> field</h5>
          <ul data-resolve-withdrawn>
            {publishedAfter.withdrawn_evidence.map((receiptId) => (
              <li><code>{receiptId}</code><small>Listed in <code>withdrawn_evidence</code></small></li>
            ))}
          </ul>
        </div>
      </section>
      <section>
        <h4>Declared graph routes</h4>
        <ul data-resolve-routes>
          {scenarios.PUBLISHED_RECORD.graph.routes.map((route) => (
            <li><span>{route.evidence.map((id) => <code>{id}</code>)}{route.premises.length > 0 && <> + {route.premises.map((id) => <code>{id}</code>)}</>} <b aria-hidden="true">→</b> <code>{route.conclusion}</code></span><small>Declared in the selected scenario graph</small></li>
          ))}
        </ul>
        <div class="resolve-exact-field">
          <h5>Exact <code>active_routes</code> field</h5>
          <ul data-resolve-active-routes>
            {publishedAfter.active_routes.map((route) => (
              <li><span>{route.evidence.map((id) => <code>{id}</code>)}{route.premises.length > 0 && <> + {route.premises.map((id) => <code>{id}</code>)}</>} <b aria-hidden="true">→</b> <code>{route.conclusion}</code></span><small>Listed in <code>active_routes</code></small></li>
            ))}
          </ul>
        </div>
      </section>
      <section>
        <h4>Claim states</h4>
        <ul data-resolve-claims>
          {Object.entries(publishedAfter.states).map(([claimId, state]) => (
            <li><code>{claimId}</code><span class="resolve-status" data-status={statusToken(state)}>{state}</span><small>{!routeConclusions.has(claimId) && claimById.get(claimId)?.kind === 'formal' ? 'No qualified support route in this snapshot' : claimById.get(claimId)?.scope}</small></li>
          ))}
        </ul>
      </section>
    </div>
    <p class="callout callout--unknown"><strong>Historic graph boundary — unchanged by simulations.</strong> No documentary-to-theorem edge is admitted. The withdrawn publication paths and the three mathematical propositions are distinct objects. Each proposition remains <code>UNKNOWN</code>.</p>
  </section>
</section>

<script>
  import '../scripts/resolve-explorer';
</script>
