---
interface Props {
  label: string;
  tone?: 'bounded' | 'implemented' | 'unknown' | 'experimental' | 'proposed' | 'rejected' | 'current' | 'superseded' | 'revoked' | 'neutral';
}

const { label, tone = 'neutral' } = Astro.props;
const status = {
  bounded: { family: 'evidence' },
  unknown: { family: 'evidence' },
  rejected: { family: 'evidence' },
  current: { family: 'lifecycle' },
  superseded: { family: 'lifecycle' },
  revoked: { family: 'lifecycle' },
  implemented: { family: 'maturity' },
  experimental: { family: 'maturity' },
  proposed: { family: 'maturity' },
  neutral: { family: 'neutral' },
} as const;
const treatment = status[tone];
---

<span class:list={['status-tag', `status-tag--${tone}`]} data-status-family={treatment.family}>
  <span class="status-tag__glyph" aria-hidden="true"></span>
  <span>{label}</span>
</span>
