---
interface Props {
  label: string;
  tone?: 'bounded' | 'implemented' | 'unknown' | 'experimental' | 'proposed' | 'rejected' | 'current' | 'superseded' | 'revoked' | 'neutral';
}

const { label, tone = 'neutral' } = Astro.props;
const status = {
  bounded: { family: 'evidence', glyph: '◆' },
  unknown: { family: 'evidence', glyph: '◇' },
  rejected: { family: 'evidence', glyph: '×' },
  current: { family: 'lifecycle', glyph: '●' },
  superseded: { family: 'lifecycle', glyph: '↗' },
  revoked: { family: 'lifecycle', glyph: '—' },
  implemented: { family: 'maturity', glyph: '■' },
  experimental: { family: 'maturity', glyph: '△' },
  proposed: { family: 'maturity', glyph: '○' },
  neutral: { family: 'neutral', glyph: '·' },
} as const;
const treatment = status[tone];
---

<span class:list={['status-tag', `status-tag--${tone}`]} data-status-family={treatment.family}>
  <span class="status-tag__glyph" aria-hidden="true">{treatment.glyph}</span>
  <span>{label}</span>
</span>
