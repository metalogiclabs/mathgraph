---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPath: string;
  socialDescription?: string;
  canonicalPath?: string;
  socialImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  currentPath,
  socialDescription = description,
  canonicalPath,
  socialImage,
  ogType = 'website',
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const absoluteSocialImage = socialImage ? new URL(socialImage, Astro.site) : undefined;
const contentSecurityPolicy = "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'";
const nav = [
  { href: '/explore/', label: 'Explore', routes: ['/explore/', '/records/', '/objects/', '/discover/'] },
  { href: '/verify/', label: 'Verify', routes: ['/verify/', '/check/', '/resolve/'] },
  { href: '/build/', label: 'Build', routes: ['/build/', '/develop/', '/capabilities/'] },
  { href: '/developers/', label: 'Developers', routes: ['/developers/', '/agents/', '/protocol/'] },
];
const normalizedPath = `${currentPath.replace(/\/+$/, '')}/`;
const currentState = (item: typeof nav[number]) => normalizedPath === item.href
  ? 'page'
  : item.routes.some(route => normalizedPath.startsWith(route)) ? 'location' : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f3" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="MathGraph" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    {absoluteSocialImage && <meta property="og:image" content={absoluteSocialImage} />}
    {absoluteSocialImage && <meta property="og:image:width" content="1200" />}
    {absoluteSocialImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={absoluteSocialImage ? 'summary_large_image' : 'summary'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner shell">
        <a class="brand" href="/" aria-label="MathGraph home">
          <img class="brand__mark" src="/mathgraph-mark-black.png" alt="" width="32" height="32" aria-hidden="true" />
          <span class="brand__word">MathGraph<span class="brand__dot">.</span></span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">Menu</button>
        <nav aria-label="Primary" id="primary-navigation">
          <ul class="nav-list">
            {nav.map((item) => (
              <li><a href={item.href} aria-current={currentState(item)}>{item.label}</a></li>
            ))}
            <li><a href="https://github.com/metalogiclabs/mathgraph" rel="external">GitHub ↗</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class="page-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner shell">
        <div>
          <p><strong>Evidence you can inspect. Results you can reuse.</strong></p>
          <p class="fineprint">MathGraph is a research-stage verification and evidence project developed by Metalogic Labs. Evidence status is scoped; unknowns remain visible.</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="/discover/">Discover</a>
          <a href="/develop/">Develop</a>
          <a href="/capabilities/">Capabilities</a>
          <a href="/records/">Evidence</a>
          <a href="/agents/">Agents</a>
          <a href="/developers/">Documentation</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="https://github.com/metalogiclabs/mathgraph">Source</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/copy';
      import '../scripts/navigation';
    </script>
  </body>
</html>
