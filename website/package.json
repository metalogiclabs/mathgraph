{
  "name": "@metalogiclabs/mathgraph.org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "npm run build && npm run test:unit",
    "test:unit": "npm run test:data && npm run test:rendering",
    "test:data": "vitest run src/lib/evidence.test.ts",
    "test:rendering": "vitest run tests/rendering.test.ts",
    "test:consumer": "node tests/consumer.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check:built": "node scripts/check-built-site.mjs",
    "check:resolver": "node scripts/check-resolver-contract.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "linkinator dist --config linkinator.config.json",
    "qualify": "npm run check && npm run test:data && npm run build && npm run test:rendering && npm run check:built && npm run check:resolver && npm run check:html && npm run check:links && npm run test:consumer"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "html-validate": "11.16.2",
    "linkinator": "8.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
