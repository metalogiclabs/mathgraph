{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mathgraph.org/schemas/presentation-metadata-v1.schema.json",
  "title": "MathGraph presentation metadata V1",
  "description": "Non-authoritative discovery and citation metadata. This object cannot strengthen an evidence warrant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema", "record_id", "record_version", "title", "description", "publisher",
    "citation", "classifications", "license", "external_registrations", "metadata_updated_at",
    "history", "content_sha256"
  ],
  "properties": {
    "$schema": { "const": "https://mathgraph.org/schemas/presentation-metadata-v1.schema.json" },
    "schema": { "const": "mathgraph.presentation-metadata.v1" },
    "record_id": { "type": "string", "pattern": "^mg-[a-z0-9-]+$" },
    "record_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "const": "https://mathgraph.org" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bibtex"],
      "properties": { "bibtex": { "type": "string", "minLength": 1 } }
    },
    "classifications": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": { "enum": ["DECLARED", "UNKNOWN"] },
        "spdx": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "external_registrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entries"],
      "properties": {
        "status": { "enum": ["DECLARED", "UNKNOWN"] },
        "entries": { "type": "array", "items": { "type": "object" } }
      }
    },
    "metadata_updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["updated_at", "change", "evidence_changed"],
        "properties": {
          "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "change": { "type": "string", "minLength": 1 },
          "evidence_changed": { "const": false }
        }
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
