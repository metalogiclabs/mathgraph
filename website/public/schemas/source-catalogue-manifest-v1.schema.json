{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathgraph.org/schemas/source-catalogue-manifest-v1.schema.json",
  "title": "MathGraph source catalogue manifest v1",
  "description": "Source publication structure only: SOURCE_INDEXED, no independent verification, applicability, action permission, or terminal form. Restricted RFC 8785/JCS bytes require scalar Unicode and safe integers, UTF-16 key order, and no newline. Python also checks source identity, counts, closed endpoints, provenance, ordering, and byte limits. Unknown noncritical extensions remain opaque and grant no authority; v1 recognizes no critical extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalogue_version",
    "catalogue_id",
    "source",
    "extractor",
    "selection_policy",
    "modules",
    "counts",
    "limits",
    "truncation",
    "reproduce_command",
    "search",
    "shards",
    "source_status",
    "verification_status",
    "current_applicability",
    "freshness",
    "authorization",
    "authority",
    "extensions"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "mathgraph.source-catalogue-manifest.v1"
    },
    "catalogue_version": {
      "type": "integer",
      "const": 1
    },
    "catalogue_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "tag",
        "license",
        "citation",
        "lean_toolchain",
        "lake_manifest",
        "root_module",
        "dependency_inventory_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "$ref": "#/$defs/file"
        },
        "citation": {
          "$ref": "#/$defs/file"
        },
        "lean_toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "value"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "lake_manifest": {
          "$ref": "#/$defs/file"
        },
        "root_module": {
          "$ref": "#/$defs/file"
        },
        "dependency_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "contract_version",
        "sources"
      ],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contract_version": {
          "type": "integer",
          "const": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "declarations",
        "ordering",
        "type_references",
        "imports",
        "omissions"
      ],
      "properties": {
        "modules": {
          "type": "string",
          "const": "EXPLICIT_MODULE_LIST"
        },
        "declarations": {
          "type": "string",
          "const": "USER_ORIGIN_SUPPORTED_WITH_RANGE"
        },
        "ordering": {
          "type": "string",
          "const": "UTF16_LEXICOGRAPHIC"
        },
        "type_references": {
          "type": "string",
          "const": "DIRECT_EXPR_CONST"
        },
        "imports": {
          "type": "string",
          "const": "DIRECT_ONLY"
        },
        "omissions": {
          "type": "string",
          "const": "NAMED_COUNTED"
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "module",
          "path",
          "sha256",
          "size_bytes",
          "objects"
        ],
        "properties": {
          "module_id": {
            "$ref": "#/$defs/moduleId"
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "object_id",
                "qualified_name"
              ],
              "properties": {
                "object_id": {
                  "$ref": "#/$defs/objectId"
                },
                "qualified_name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "objects",
        "relations",
        "omitted_type_references",
        "omitted_imports",
        "omitted_declarations"
      ],
      "properties": {
        "modules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "relations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omitted_type_references": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omitted_imports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omitted_declarations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_declarations",
        "max_relations",
        "max_search_bytes",
        "max_shard_bytes",
        "max_manifest_bytes",
        "max_projection_nodes",
        "max_projection_edges"
      ],
      "properties": {
        "max_declarations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2500
        },
        "max_relations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25000
        },
        "max_search_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "max_shard_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "max_manifest_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_projection_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_projection_edges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurred",
        "reason"
      ],
      "properties": {
        "occurred": {
          "type": "boolean",
          "const": false
        },
        "reason": {
          "type": "null"
        }
      }
    },
    "reproduce_command": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "object_count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "object_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "path",
          "sha256",
          "size_bytes",
          "object_count",
          "relation_count",
          "omitted_type_references",
          "omitted_imports",
          "omitted_declarations"
        ],
        "properties": {
          "module_id": {
            "$ref": "#/$defs/moduleId"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "object_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "relation_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "omitted_type_references": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "omitted_imports": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "omitted_declarations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1
    },
    "source_status": {
      "type": "string",
      "const": "SOURCE_INDEXED"
    },
    "verification_status": {
      "type": "string",
      "const": "NOT_CHECKED"
    },
    "current_applicability": {
      "type": "string",
      "const": "NOT_CHECKED"
    },
    "freshness": {
      "type": "string",
      "const": "PINNED_HISTORICAL_SOURCE"
    },
    "authorization": {
      "type": "string",
      "const": "NONE"
    },
    "authority": {
      "type": "string",
      "const": "NONE"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001f\\u007f]).*[^/]$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^module-[0-9a-f]{64}$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^object-[0-9a-f]{64}$"
    },
    "relationId": {
      "type": "string",
      "pattern": "^relation-[0-9a-f]{64}$"
    },
    "canonicalValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/canonicalValue"
          },
          "propertyNames": {
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "critical",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "critical": {
          "type": "boolean",
          "const": false
        },
        "payload": {
          "$ref": "#/$defs/canonicalValue"
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column",
        "byte"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        }
      }
    }
  }
}
