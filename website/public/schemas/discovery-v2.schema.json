{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mathgraph.org/schemas/discovery-v2.schema.json",
  "title": "MathGraph discovery manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "canonical_origin", "generated_at", "agent_guide", "llms_txt", "record_index", "schemas", "capabilities", "interfaces", "freshness", "integrity_notice", "repository_provenance"],
  "properties": {
    "$schema": { "const": "https://mathgraph.org/schemas/discovery-v2.schema.json" },
    "schema": { "const": "mathgraph.discovery.v2" },
    "canonical_origin": { "const": "https://mathgraph.org" },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "agent_guide": { "$ref": "#/$defs/url" },
    "llms_txt": { "$ref": "#/$defs/url" },
    "record_index": { "$ref": "#/$defs/url" },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_v1", "discovery_v2", "public_consequence_record_v1", "record_index_v1", "record_index_v2", "living_warrant_snapshot_v1", "resolve_scenarios_v1", "presentation_metadata_v1", "lean_evidence_profile_draft_1"],
      "properties": {
        "discovery_v1": { "const": "https://mathgraph.org/schemas/discovery-v1.schema.json" },
        "discovery_v2": { "const": "https://mathgraph.org/schemas/discovery-v2.schema.json" },
        "public_consequence_record_v1": { "const": "https://mathgraph.org/schemas/public-consequence-record-v1.schema.json" },
        "record_index_v1": { "const": "https://mathgraph.org/schemas/record-index-v1.schema.json" },
        "record_index_v2": { "const": "https://mathgraph.org/schemas/record-index-v2.schema.json" },
        "living_warrant_snapshot_v1": { "const": "https://mathgraph.org/schemas/living-warrant-snapshot-v1.schema.json" },
        "resolve_scenarios_v1": { "const": "https://mathgraph.org/schemas/resolve-scenarios-v1.schema.json" },
        "presentation_metadata_v1": { "const": "https://mathgraph.org/schemas/presentation-metadata-v1.schema.json" },
        "lean_evidence_profile_draft_1": { "const": "https://mathgraph.org/schemas/lean-evidence-profile-draft-1.schema.json" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_records", "resolve_explorer", "offline_resolve_replay", "public_resolver", "discover_interface", "develop_interface", "capabilities_registry", "lean_profile", "mcp"],
      "properties": {
        "static_records": { "const": "IMPLEMENTED" },
        "resolve_explorer": { "const": "IMPLEMENTED_READ_ONLY" },
        "offline_resolve_replay": { "const": "BOUNDED_QUALIFIED" },
        "public_resolver": { "const": "NOT_DEPLOYED" },
        "discover_interface": { "const": "NOT_DEPLOYED" },
        "develop_interface": { "const": "NOT_DEPLOYED" },
        "capabilities_registry": { "const": "PROPOSED" },
        "lean_profile": { "const": "PROPOSED" },
        "mcp": { "const": "PROPOSED" }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "resolve", "discover", "develop", "capabilities"],
      "properties": {
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maturity", "mode", "record_id", "record_page", "record_json"],
          "properties": {
            "maturity": { "const": "IMPLEMENTED_AT_QUALIFIED_BOUNDARY" },
            "mode": { "const": "STATIC_RECORD" },
            "record_id": { "const": "mg-l4yaml-source-check-20261010" },
            "record_page": { "const": "https://mathgraph.org/records/mg-l4yaml-source-check-20261010/v1/" },
            "record_json": { "const": "https://mathgraph.org/evidence/mg-l4yaml-source-check-20261010/record.json" }
          }
        },
        "resolve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maturity", "mode", "record_id", "explorer", "record_page", "record_json", "scenarios_json", "offline_consumer", "offline_consumer_sha256", "offline_bundle", "offline_bundle_sha256", "offline_trust_policy", "offline_trust_policy_sha256", "offline_replay_output_sha256", "typescript_consumer", "typescript_consumer_sha256", "current_applicability", "freshness"],
          "properties": {
            "maturity": { "const": "BOUNDED_QUALIFIED" },
            "mode": { "const": "OFFLINE_REPLAY" },
            "record_id": { "const": "mg-living-warrant-openai-jpl-20261010" },
            "explorer": { "const": "https://mathgraph.org/resolve/" },
            "record_page": { "const": "https://mathgraph.org/records/mg-living-warrant-openai-jpl-20261010/v1/" },
            "record_json": { "const": "https://mathgraph.org/evidence/mg-living-warrant-openai-jpl-20261010/record.json" },
            "scenarios_json": { "const": "https://mathgraph.org/evidence/mg-living-warrant-openai-jpl-20261010/scenarios.json" },
            "offline_consumer": { "const": "https://mathgraph.org/evidence/mg-living-warrant-openai-jpl-20261010/offline/consumer.py" },
            "offline_consumer_sha256": { "const": "27a9be606040cc94a47c9b903dfc1cb24a86cbbc4e05ce71040c6c3d6e8d527b" },
            "offline_bundle": { "const": "https://mathgraph.org/evidence/mg-living-warrant-openai-jpl-20261010/offline/bundle.json" },
            "offline_bundle_sha256": { "const": "957080db79555f982fd3a314c263cf5177ef506969229e856897f0b19ccc1d62" },
            "offline_trust_policy": { "const": "https://mathgraph.org/evidence/mg-living-warrant-openai-jpl-20261010/offline/trust-policy.json" },
            "offline_trust_policy_sha256": { "const": "09e8d5ba97bca126a81dfe0fcbd5d57f3915ffe71402a497ece4d5e6117f2b4a" },
            "offline_replay_output_sha256": { "const": "8c7b30e1eb2a24d2960e170d36652ca95aa71b41075f673abe394e154ae66668" },
            "typescript_consumer": { "const": "https://mathgraph.org/examples/resolve-consumer-v1.ts" },
            "typescript_consumer_sha256": { "const": "e7360df24b2fd0900c8ea88ccb1689163cec73a6c2e2347e4ab2b23b4d01bc2e" },
            "current_applicability": { "const": "UNKNOWN" },
            "freshness": { "const": "NOT_CHECKED" }
          }
        },
        "discover": { "$ref": "#/$defs/experimental_interface" },
        "develop": { "$ref": "#/$defs/experimental_interface" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maturity", "public_registry", "entries"],
          "properties": {
            "maturity": { "const": "PROPOSED" },
            "public_registry": { "const": "NOT_DEPLOYED" },
            "entries": { "const": 0 }
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "record_index_max_age_seconds", "lifecycle_meaning"],
      "properties": {
        "basis": { "const": "CLIENT_FETCH_TIME" },
        "record_index_max_age_seconds": { "const": 300 },
        "lifecycle_meaning": { "const": "generated_at is publication time; set fetched_at when received and re-fetch before max_age_seconds elapse." }
      }
    },
    "integrity_notice": { "type": "string", "minLength": 1 },
    "repository_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "catalogue_source", "authentication_status"],
      "properties": {
        "repository": { "const": "https://github.com/metalogiclabs/mathgraph" },
        "catalogue_source": { "type": "string", "pattern": "^https://github\\.com/metalogiclabs/mathgraph/" },
        "authentication_status": { "const": "UNSIGNED_PROVENANCE_ONLY" }
      }
    }
  },
  "$defs": {
    "url": { "type": "string", "pattern": "^https://mathgraph\\.org/" },
    "experimental_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maturity", "public_interface"],
      "properties": {
        "maturity": { "const": "EXPERIMENTAL" },
        "public_interface": { "const": "NOT_DEPLOYED" }
      }
    }
  }
}
