{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mathgraph.org/schemas/resolve-scenarios-v1.schema.json",
  "title": "MathGraph precomputed Resolve scenarios V1",
  "description": "Separate historical and synthetic structures. This schema does not resolve a graph or qualify new evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "snapshot_sha256",
    "transport_sha256",
    "provenance",
    "maturity",
    "status_contract",
    "PUBLISHED_RECORD",
    "SYNTHETIC_CONFORMANCE"
  ],
  "properties": {
    "schema": {
      "const": "mathgraph.resolve-scenarios.v1"
    },
    "record_id": {
      "const": "mg-living-warrant-openai-jpl-20261010"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transport_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "const": {
        "consumer": {
          "boundary": "Implementation-independent replay under the same owner; does not rerun the original JPL Lean proof.",
          "commit": "9b3189a64825e2cb6ebc7b5c17f5f193bdf5cfe3",
          "implementation_independent": true,
          "independently_owned_adoption": false,
          "name": "RealityGraph",
          "repository": "heathsanchez/realitygraph",
          "reruns_jpl_lean_proof": false,
          "run_id": "38025236380",
          "run_url": "https://github.com/heathsanchez/realitygraph/actions/runs/38025236380",
          "same_owner": true
        },
        "integrity_boundary": "Pinned hashes detect byte substitution; self-hashes do not authenticate publishers or qualify new evidence.",
        "producer": {
          "commit": "040456fc8862c79c8b384ce63846628274b678be",
          "repository": "metalogiclabs/mathgraph",
          "run_id": "38025044631",
          "run_url": "https://github.com/metalogiclabs/mathgraph/actions/runs/38025044631"
        }
      }
    },
    "maturity": {
      "const": {
        "action_policy": "READ_ONLY_PRECOMPUTED_SELECTION",
        "lifecycle": "PUBLISHED_IMMUTABLE_SNAPSHOT",
        "research_maturity": "BOUNDED_REFERENCE_IMPLEMENTATION",
        "runtime_status": "IMMUTABLE_HISTORICAL_SNAPSHOT_NOT_CONTINUOUSLY_MONITORED"
      }
    },
    "status_contract": {
      "const": {
        "resolutions": "Compared with the graph's no-withdrawal baseline (modeled-before for PUBLISHED_RECORD); STALE marks lost support, never theorem refutation.",
        "states": "Raw kernel epistemic results at each claim's original kind and scope.",
        "terminal_form_admission": "These warrant states do not accept new mathematical claims into the terminal-form kernel."
      }
    },
    "PUBLISHED_RECORD": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "default_scenario",
        "graph",
        "scenarios"
      ],
      "properties": {
        "classification": {
          "const": "PUBLISHED_RECORD"
        },
        "default_scenario": {
          "const": "published-after"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "description",
              "basis",
              "active_routes",
              "withdrawn_evidence",
              "states",
              "resolutions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "MODELED_BEFORE",
                  "PUBLISHED_AFTER",
                  "SIMULATION"
                ]
              },
              "active_routes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/route"
                },
                "minItems": 0
              },
              "withdrawn_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "states": {
                "$ref": "#/$defs/states"
              },
              "resolutions": {
                "$ref": "#/$defs/resolutions"
              },
              "baseline": {
                "const": "modeled-before"
              }
            }
          },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "SYNTHETIC_CONFORMANCE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "description",
        "historical_fact",
        "purpose",
        "scenarios"
      ],
      "properties": {
        "classification": {
          "const": "SYNTHETIC_CONFORMANCE"
        },
        "description": {
          "const": "Synthetic kernel tests, not historical facts about OpenAI or JPL."
        },
        "historical_fact": {
          "const": false
        },
        "purpose": {
          "const": "KERNEL_TESTS"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "description",
              "basis",
              "active_routes",
              "withdrawn_evidence",
              "states",
              "resolutions",
            "graph"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "const": "KERNEL_TEST"
              },
              "active_routes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/route"
                },
                "minItems": 0
              },
              "withdrawn_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "states": {
                "$ref": "#/$defs/states"
              },
              "resolutions": {
                "$ref": "#/$defs/resolutions"
              },
            "graph": {
                "$ref": "#/$defs/graph"
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "documentary",
            "formal"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "evidence",
        "premises"
      ],
      "properties": {
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "premises": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "status": {
      "enum": [
        "UNKNOWN",
        "STALE",
        "SOURCE_DOCUMENTED",
        "WARRANTED_BOUNDED"
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "changed"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/status"
        },
        "after": {
          "$ref": "#/$defs/status"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "resolutions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/resolution"
      }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/status"
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "receipts",
        "routes"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 1
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 0
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          },
          "minItems": 0
        }
      }
    }
  }
}
