{
  "info": {
    "title": "MathGraph Check \u2014 read-only evidence API",
    "version": "0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/badges/mg-l4yaml-source-check-20261010.svg": {
      "get": {
        "responses": {
          "200": {
            "description": "SVG scoped status"
          }
        },
        "summary": "Only scoped finite-case status, not theorem truth"
      }
    },
    "/v1/records/mg-l4yaml-source-check-20261010": {
      "get": {
        "responses": {
          "200": {
            "description": "Immutable snapshot"
          }
        },
        "summary": "Read the pinned L4YAML research record"
      }
    },
    "/v1/records/mg-l4yaml-source-check-20261010/evidence": {
      "get": {
        "responses": {
          "200": {
            "description": "Source receipts"
          }
        },
        "summary": "Read exact upstream evidence references"
      }
    },
    "/v1/resolve": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "external_suite_commit": {
                    "const": "da267a5c4782e7361e82889e76c0dc7df0e1e870"
                  },
                  "goal": {
                    "type": "string"
                  },
                  "record_id": {
                    "const": "mg-l4yaml-source-check-20261010"
                  },
                  "source_commit": {
                    "const": "62bf7077910e888a0bc8adfc8e08a5f500ff3ca3"
                  }
                },
                "required": [
                  "record_id",
                  "source_commit",
                  "external_suite_commit",
                  "goal"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "WARRANTED_BOUNDED or explicit UNKNOWN"
          },
          "400": {
            "description": "Invalid typed query"
          }
        },
        "summary": "Resolve only a pinned scope-qualified consequence; no mutation"
      }
    }
  },
  "servers": [
    {
      "description": "Local development only; no hosted API is claimed",
      "url": "http://127.0.0.1:8796"
    }
  ]
}
