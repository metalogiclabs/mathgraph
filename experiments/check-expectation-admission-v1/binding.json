  "patch": {
    "summary": "Preserve command position when control keywords occur as arguments. Replay only against independently admitted finite expectations.",
    "edits": [
      {
        "old": "        else go (if (assignment? t).isSome then cmdPos else opensCommand t) false rest",
        "new": "        else\n          let control := t == \"|\" || t == \"||\" || t == \"&&\" || t == \";\" ||\n            t == \"&\" || t == \"(\" || t == \")\" || t == \"$(\"\n          let nextPos :=\n            if (assignment? t).isSome then cmdPos\n            else control || (cmdPos && opensCommand t)\n          go nextPos false rest"
      }
    ]
  },
