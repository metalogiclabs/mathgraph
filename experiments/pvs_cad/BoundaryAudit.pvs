BoundaryAudit: THEORY
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  % In-fragment controls and edge families.
  control_linear: THEOREM FORALL (x: real): x * x >= 0
  control_quadratic: THEOREM FORALL (a: real):
    FORALL (b: real):
      FORALL (c: real):
        EXISTS (x: real):
          a /= 0 AND b^2 >= 4*a*c IMPLIES a*x^2+b*x+c=0
  zero_poly_eq: THEOREM FORALL (x: real): 0*x = 0
  repeated_root: THEOREM FORALL (x: real): (x-1)^2 >= 0
  strict_boundary: THEOREM FORALL (x: real): NOT (x > 0 AND x < 0)
  alternation: THEOREM FORALL (x: real): EXISTS (y: real): y > x
  renamed_alternation: THEOREM FORALL (u: real): EXISTS (v: real): v > u
  rational_coeff: THEOREM FORALL (x: real): x/2 + x/2 = x
  decimal_coeff: THEOREM FORALL (x: real): 0.5*x = x/2
  connective_mix: THEOREM FORALL (x: real):
    (x = 0 IFF NOT (x /= 0)) AND (x >= 0 OR x < 0)
  vacuous_true: THEOREM FORALL (x: real): TRUE

  % Definition expansion is deliberately outside the primitive CAD surface.
  sqplus1(x: real): real = x*x + 1
  hidden_definition: THEOREM FORALL (x: real): sqplus1(x) > 0

  % A quantified-variable-dependent denominator is not polynomial and must
  % not silently become an independent real atom.
  nonpoly_variable_denominator: THEOREM FORALL (x: real):
    x /= 0 IMPLIES x/x = 1

  % cad-prefix intentionally accepts one binder per quantifier node.
  grouped_binders: THEOREM FORALL (x,y: real): x*x + y*y >= 0

  % A proper subtype quantifier must not be silently reinterpreted as all reals.
  nonneg: TYPE = {x: real | x >= 0}
  subtype_false: THEOREM EXISTS (x: nonneg): x < 0

  % cad-star conservativity: f(a) is abstracted as an unknown real, but the
  % abstraction must still be sufficient to prove this implication.
  f: [real -> real]
  a: VAR real
  abstracted_function_sound: THEOREM f(a) > a*a IMPLIES f(a) > -1

END BoundaryAudit
