{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "cd website && npm ci --ignore-scripts",
  "buildCommand": "cd website && npm run build",
  "outputDirectory": "website/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/v1/records/mg-l4yaml-source-check-20261010",
      "destination": "/evidence/mg-l4yaml-source-check-20261010/record.json",
      "permanent": true
    },
    {
      "source": "/v1/records/mg-l4yaml-source-check-20261010/evidence",
      "destination": "/evidence/mg-l4yaml-source-check-20261010/evidence.json",
      "permanent": true
    },
    {
      "source": "/v1/badges/mg-l4yaml-source-check-20261010.svg",
      "destination": "/evidence/mg-l4yaml-source-check-20261010/scoped-status.svg",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/evidence/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/schemas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/records/(.*)/v(.*)/metadata.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/social/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/records/(.*)/v(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/records/index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/.well-known/mathgraph.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        }
      ]
    }
  ]
}
