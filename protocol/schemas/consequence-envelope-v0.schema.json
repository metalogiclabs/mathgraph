{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MathGraph consequence envelope v0 candidate (no authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "statement",
    "scope",
    "authority",
    "evidence",
    "payload",
    "relations",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "mathgraph.consequence-envelope.v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "claim",
        "observation",
        "obstruction",
        "capability",
        "experiment"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_id",
          "target_version",
          "evidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "requires",
              "derived_from",
              "refines",
              "supersedes",
              "conflicts_with",
              "reused_in"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/$defs/ref"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
